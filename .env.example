SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_ORACLE_PUBLIC_IP

# --- Local Postgres (used when DATABASE_URL is empty) ---
DB_NAME=smart_grievance
DB_USER=postgres
DB_PASSWORD=super123
DB_HOST=localhost
DB_PORT=5433

# --- Supabase (preferred in production) ---
# Use Session / Direct connection for Django GIS migrations (port 5432), not Transaction pooler only.
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True

# Frontend (Vercel) — comma-separated, no trailing slash
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR_APP.vercel.app
BACKEND_PUBLIC_URL=http://YOUR_ORACLE_PUBLIC_IP

# Redis (optional). For free VM without Redis, set ALWAYS_EAGER=True
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True

MEDIA_SERVE=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Linux GDAL (usually auto-detected after apt install; set only if needed)
# GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
